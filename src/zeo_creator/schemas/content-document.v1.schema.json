{
  "$defs": {
    "BlockKind": {
      "enum": [
        "heading",
        "paragraph",
        "list_item",
        "quote",
        "code",
        "caption",
        "other"
      ],
      "title": "BlockKind",
      "type": "string"
    },
    "DocumentBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "kind",
        "text"
      ],
      "title": "DocumentBlock",
      "type": "object"
    },
    "DocumentLink": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "href": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f\\\\]+$",
          "title": "Href",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "href"
      ],
      "title": "DocumentLink",
      "type": "object"
    },
    "DocumentMedia": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Text"
        },
        "block_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Media Id",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "media_type",
        "digest"
      ],
      "title": "DocumentMedia",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/DocumentBlock"
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "content_class": {
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Content Class",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Document Id",
      "type": "string"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "language": {
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "title": "Language",
      "type": "string"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DocumentLink"
      },
      "title": "Links",
      "type": "array"
    },
    "media": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DocumentMedia"
      },
      "title": "Media",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "document_id",
    "content_class",
    "language",
    "title",
    "blocks",
    "source_revision",
    "source_digest"
  ],
  "title": "NormalizedDocument",
  "type": "object"
}
