#!/bin/sh
# One gate: a push runs `make verify`. Enabled by `make setup` (core.hooksPath).
# A push that only deletes branches has nothing to verify.
zero=0000000000000000000000000000000000000000
verify=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] || verify=1
done
[ "$verify" = 1 ] || exit 0
echo "pre-push: running make verify (about 4 minutes)" >&2
exec make verify
